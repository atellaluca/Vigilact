{
  "additionalProperties": false,
  "description": "Supported CloudEvents JSON subset; other extensions are not implemented.",
  "properties": {
    "specversion": {
      "const": "1.0",
      "title": "Specversion",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "source": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "type": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Type",
      "type": "string"
    },
    "subject": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Subject",
      "type": "string"
    },
    "time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Time"
    },
    "datacontenttype": {
      "const": "application/json",
      "default": "application/json",
      "title": "Datacontenttype",
      "type": "string"
    },
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject"
  ],
  "title": "CloudEvent",
  "type": "object"
}
