  "components": {
    "schemas": {
      "Capability": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$",
            "title": "Name"
          },
          "mode": {
            "type": "string",
            "enum": [
              "query",
              "command"
            ],
            "title": "Mode"
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "title": "Description",
            "default": ""
          },
          "invocable": {
            "type": "boolean",
            "title": "Invocable",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "mode"
        ],
        "title": "Capability"
      },
      "CapabilityManifest": {
        "properties": {
          "capabilities": {
            "items": {
              "$ref": "#/components/schemas/Capability"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Capabilities"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "capabilities"
        ],
        "title": "CapabilityManifest"
      },
      "CapabilityView": {
        "properties": {
          "agent": {
            "type": "string",
            "title": "Agent"
          },
          "capabilities": {
            "items": {
              "$ref": "#/components/schemas/Capability"
            },
            "type": "array",
            "title": "Capabilities"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "agent",
          "capabilities"
        ],
        "title": "CapabilityView"
      },
      "CloudEvent": {
        "properties": {
          "specversion": {
            "type": "string",
            "const": "1.0",
            "title": "Specversion"
          },
          "id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Id"
          },
          "source": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Source"
          },
          "type": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Type"
          },
          "subject": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Subject"
          },
          "time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time"
          },
          "datacontenttype": {
            "type": "string",
            "const": "application/json",
            "title": "Datacontenttype",
            "default": "application/json"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "specversion",
          "id",
          "source",
          "type",
          "subject"
        ],
        "title": "CloudEvent",
        "description": "Supported CloudEvents JSON subset; other extensions are not implemented."
      },
      "CommandList": {
        "properties": {
          "commands": {
            "items": {
              "$ref": "#/components/schemas/CommandView"
            },
            "type": "array",
            "title": "Commands"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "commands"
        ],
        "title": "CommandList"
      },
      "CommandRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
            "title": "Request Id"
          },
          "target_agent": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "title": "Target Agent"
          },
          "capability": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$",
            "title": "Capability"
          },
          "arguments": {
            "additionalProperties": true,
            "type": "object",
            "title": "Arguments"
          },
          "ttl_seconds": {
            "type": "integer",
            "maximum": 86400.0,
            "minimum": 1.0,
            "title": "Ttl Seconds",
            "default": 300
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "target_agent",
          "capability"
        ],
        "title": "CommandRequest"
      },
